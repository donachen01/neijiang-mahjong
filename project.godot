; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="内江麻将"
config/version="1.0.63"
run/main_scene="res://scenes/boot/SplashScreen.tscn"
config/features=PackedStringArray("4.6", "C#")
config/icon="res://res/art/app_icon/app_icon_1024.png"

[autoload]

NeijiangCSharpRuntime="*res://scripts/ai/NeijiangCSharpRuntime.cs"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="NeijiangMahjong.Godot"

[rendering]

; The Sichuan-derived 3D table uses Filmic tonemapping, SSAO, layered lighting,
; and imported PBR materials. Keep mobile on the same Forward+ contract as the
; source project; Compatibility can leave the iOS 3D pass blank while the HUD
; CanvasLayer continues to render.
renderer/rendering_method.mobile="forward_plus"
