; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="内江麻将"
config/version="1.0.89"
run/main_scene="res://scenes/boot/SplashScreen.tscn"
config/features=PackedStringArray("4.6", "C#")
config/icon="res://res/art/app_icon/app_icon_1024.png"

[autoload]

NeijiangCSharpRuntime="*res://scripts/ai/NeijiangCSharpRuntime.cs"
GameState="*res://autoload/GameState.gd"
LanRuntime="*res://autoload/LanRuntime.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="NeijiangMahjong.Godot"

[performance]

mobile_active_frame_cap=60
mobile_idle_frame_cap=30
mobile_idle_delay_msec=1400
mobile_low_processor_sleep_usec=10000

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
; 桌面使用 Forward+，iOS/Android 使用 Mobile 渲染器。
renderer/rendering_method.mobile="mobile"
